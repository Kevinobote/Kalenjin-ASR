cv-corpus-24.0-2025-12-05-kln/
cv-corpus-24.0-2025-12-05-kln.tar.gz
*.tar.gz
*.zip

# Processed dataset (regenerate from notebooks)
processed_data/kalenjin_asr_dataset/
data/

