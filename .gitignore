venv/
env/
ENV/
audio_ml/
.venv

# ============================================================================
# JUPYTER NOTEBOOKS
# ============================================================================
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Jupyter Notebook temporary files
*.ipynb_checkpoints

# ============================================================================
# LOGS & TEMPORARY FILES
# ============================================================================
*.log
logs/
preprocessing.log
training.log

# Temporary files
*.tmp
*.temp
*.swp
*.swo
*~

# ============================================================================
# RESULTS & OUTPUTS (Optional - keep small summaries)
# ============================================================================
# Keep results/ but ignore large files
results/**/*.wav
results/**/*.mp3
results/**/*.png
results/**/*.jpg

# ============================================================================
# IDE & EDITOR
# ============================================================================
# VSCode
.vscode/
*.code-workspace

# PyCharm
.idea/
*.iml

# Sublime Text
*.sublime-project
*.sublime-workspace

# ============================================================================
# OPERATING SYSTEM
# ============================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Linux
*~
.directory

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ============================================================================
# CACHE & HUGGINGFACE
# ============================================================================
.cache/
.huggingface/
wandb/
.neptune/

# ============================================================================
# TESTING & COVERAGE
# ============================================================================
.pytest_cache/
.coverage
htmlcov/
.tox/

# ============================================================================
# KEEP THESE FILES (Explicitly tracked)
# ============================================================================
# Configuration files
!requirements.txt
!README.md
!LICENSE
!.gitignore

# Notebooks (keep source code)
!notebooks/*.ipynb
!notebooks/*.py

# Scripts
!scripts/*.py
!scripts/*.sh

# Small result files (summaries only)
!results/quality_assessment/*.json
!results/quality_assessment/*.txt

# Vocabulary (small file)
!processed_data/vocab.json
